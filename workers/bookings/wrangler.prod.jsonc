{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "curacao-bookings-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curacao-bookings-prod",
      "database_id": "ae8ccf45-3fdc-4a6a-ae84-6b97b95df20c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYMENTS_MODE": "live",
    "BOOKINGS_ENABLED": "true",
    "EMAIL_SENDING_ENABLED": "true",
    "EMAIL_FROM": "bookings@notifications.wowatour.com",
    "EMAIL_FROM_NAME": "Curacao Cruise Excursions",
    "EMAIL_REPLY_TO": "hello@curacaocruiseexcursions.com",
    "CORS_ALLOWED_ORIGINS": "https://curacaocruiseexcursions.com,https://www.curacaocruiseexcursions.com",
    "SITE_BASE_URL": "https://curacaocruiseexcursions.com",
    "ORIGINATING_SITE": "curacaocruiseexcursions.com",
    "ORIGINATING_PORT": "Willemstad, Curacao",
    "OPERATOR_PORTAL_BASE_URL": "https://curacao-bookings-prod.dark-violet-8d91.workers.dev",
    "LIVE_PAYMENTS_UNLOCK": "CURACAO_LIVE_UNLOCK"
  }
}
